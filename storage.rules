rules_version = '2';

// Firebase Storage security rules for Lift.
// Deploy with: `firebase deploy --only storage`
// Or paste into Firebase Console → Storage → Rules → Publish.

service firebase.storage {
  match /b/{bucket}/o {
    // Each user can read/write only their own subtree under /users/{uid}/...
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/(gif|png|jpeg|webp)');
    }
    // Public reads would be configured here if needed — not used yet.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
